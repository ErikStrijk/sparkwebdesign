---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Getallenbalk from '../components/Getallenbalk.astro';
import Prijskaart from '../components/Prijskaart.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Portfolio from '../components/Portfolio.astro';
import OverMij from '../components/OverMij.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---
<Layout>
  <Header />
  <main id="main">
    <Hero />
    <Getallenbalk />
    <Prijskaart />
    <Werkwijze />
    <Portfolio />
    <OverMij />
    <Reviews />
    <FAQ />
    <Contact />
  </main>
  <Footer />
  <StickyCta />
</Layout>
