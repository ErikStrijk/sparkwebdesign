---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import T from './T.astro';
import { overMij } from '../data/overmij';
---
<section class="section about on-dark" id="over-mij" aria-labelledby="over-title">
  <div class="container grid">
    <div class="photo" data-reveal>
      {overMij.photo ? (
        <Image src={overMij.photo} alt={overMij.photoAlt} widths={[400, 640, 960]} sizes="(min-width: 60rem) 40vw, 100vw" />
      ) : (
        <div class="ph" role="img" aria-label="Plek voor je foto"><Icon name="user" size={40} /><span class="placeholder-tag">[FOTO]</span></div>
      )}
    </div>

    <div class="copy">
      <h2 id="over-title" data-reveal><T text={overMij.title} /></h2>
      {overMij.paragraphs.map((p) => <p class="p" data-reveal><T text={p} /></p>)}
      <ul class="points">
        {overMij.points.map((pt, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <h3>{pt.title}</h3>
            <p><T text={pt.text} /></p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 5rem); align-items: center; }
  .photo {
    aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden;
    max-width: 26rem; width: 100%;
    background: var(--c-brand-deep);
  }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph {
    height: 100%; display: grid; place-content: center; justify-items: center; gap: var(--space-3);
    color: var(--c-on-dark-soft);
    border: 2px dashed rgb(255 255 255 / 0.28); border-radius: inherit;
  }
  h2 {
    font-size: var(--fs-h2); letter-spacing: var(--tracking-h2); line-height: 1.08; color: var(--c-on-dark);
  }
  .p { margin-top: var(--space-4); font-size: var(--fs-lede); color: var(--c-on-dark-soft); max-width: var(--measure); }
  .p:first-of-type { color: var(--c-on-dark); }
  .points {
    list-style: none; padding: 0; margin-top: var(--space-7);
    display: grid; gap: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.2); padding-top: var(--space-6);
  }
  .points h3 { font-size: 1.125rem; letter-spacing: -0.01em; color: var(--c-on-dark); }
  .points p { margin-top: var(--space-1); font-size: var(--fs-small); color: var(--c-on-dark-soft); }

  @media (min-width: 40rem) { .points { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 60rem) {
    .grid { grid-template-columns: 5fr 7fr; }
    .photo { aspect-ratio: 4 / 5; }
  }
</style>
