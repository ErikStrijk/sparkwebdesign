---
import Icon from './Icon.astro';
import T from './T.astro';
import AanvraagForm from './AanvraagForm.astro';
import { site, whatsappHref } from '../data/site';
---
<section class="section contact on-dark" id="contact" aria-labelledby="contact-title">
  <div class="container grid">
    <div class="intro">
      <h2 id="contact-title" data-reveal>{site.cta}</h2>
      <p class="lede" data-reveal>
        Vertel kort over je zaak. Ik reageer binnen <T text={site.responseTime} /> en maak gratis een eerste ontwerp voor je.
      </p>
      <ul class="promises" data-reveal>
        <li><span class="dot"><Icon name="check" size={16} /></span>Gratis en vrijblijvend</li>
        <li><span class="dot"><Icon name="check" size={16} /></span>€{site.upfront} vooraf, je betaalt bij livegang</li>
        <li><span class="dot"><Icon name="check" size={16} /></span>Binnen {site.daysToLive} dagen live</li>
      </ul>
      <div class="alt" data-reveal>
        <p>Liever even appen of mailen?</p>
        <div class="alt-row">
          <a class="btn btn--ghost btn--sm" href={whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
          <a class="btn btn--ghost btn--sm" href={`mailto:${site.email.replace(/[\[\]]/g, '')}`}><Icon name="mail" size={18} /><T text={site.email} /></a>
        </div>
      </div>
    </div>

    <AanvraagForm id="contact" />
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 4.5rem); align-items: start; }
  h2 { font-size: var(--fs-h2); letter-spacing: var(--tracking-h2); line-height: 1.05; color: var(--c-on-dark); max-width: 13ch; }
  .lede { margin-top: var(--space-4); font-size: var(--fs-lede); color: var(--c-on-dark-soft); max-width: 30rem; }
  .promises { list-style: none; padding: 0; margin-top: var(--space-6); display: grid; gap: var(--space-3); font-weight: 600; }
  .promises li { display: flex; gap: 0.7rem; align-items: center; }
  .dot {
    display: grid; place-items: center; flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%;
    background: rgb(255 255 255 / 0.12); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .alt { margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid rgb(255 255 255 / 0.2); }
  .alt p { color: var(--c-on-dark-soft); font-size: var(--fs-small); }
  .alt-row { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .alt-row :global(.placeholder-tag) { font-size: 0.9em; }

  @media (min-width: 60rem) { .grid { grid-template-columns: 5fr 6fr; } }
</style>
