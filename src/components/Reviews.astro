---
import T from './T.astro';
import { reviews } from '../data/reviews';
---
<section class="section" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="reviews-title">Wat klanten zeggen</h2>
      <p>Ik ben net begonnen. Hier komen straks de eerlijke woorden van mijn eerste klanten. Niet verzonnen, beloofd.</p>
    </div>

    <ul class="grid">
      {reviews.map((r, i) => (
        <li data-reveal style={`--reveal-i:${i}`}>
          <figure>
            <svg class="q" viewBox="0 0 32 24" aria-hidden="true" focusable="false"><path d="M0 24V14C0 6 4 1.5 12 0l1.5 3.5C9 5 7 8 7 11h5v13zm18 0V14c0-8 4-12.5 12-14l1.5 3.5C27 5 25 8 25 11h5v13z" /></svg>
            <blockquote><p><T text={r.quote} /></p></blockquote>
            <figcaption><b><T text={r.name} /></b><span><T text={r.business} /></span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { list-style: none; padding: 0; display: grid; gap: var(--space-5); }
  figure {
    height: 100%; display: flex; flex-direction: column; gap: var(--space-4);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border: 1px solid var(--c-line); border-radius: var(--radius-lg); background: var(--grad-card);
    box-shadow: var(--shadow-sm);
  }
  .q { width: 2rem; fill: var(--c-brand); }
  blockquote { font-size: 1.125rem; line-height: 1.5; font-weight: 500; }
  figcaption { margin-top: auto; display: grid; font-size: var(--fs-small); padding-top: var(--space-4); border-top: 1px solid var(--c-line); }
  figcaption span { color: var(--c-muted); }

  @media (min-width: 52rem) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
