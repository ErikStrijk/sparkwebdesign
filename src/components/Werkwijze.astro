---
import Cta from './Cta.astro';
import { steps, site } from '../data/site';
---
<section class="section" id="werkwijze" aria-labelledby="werkwijze-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="werkwijze-title">In 3 stappen live. Binnen {site.daysToLive} dagen.</h2>
      <p>Jij hoeft niks technisch te weten. Ik regel alles en houd je op de hoogte.</p>
    </div>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step" data-reveal style={`--reveal-i:${i}`}>
          <span class="n num" aria-hidden="true">{i + 1}</span>
          <div class="body">
            <p class="when">{s.when}</p>
            <h3>{s.title}</h3>
            <p class="text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="after" data-reveal><Cta /></div>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; display: grid; gap: 0; counter-reset: step; }
  .step { position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--space-5); padding-bottom: var(--space-7); }
  .step:last-child { padding-bottom: 0; }
  /* verbindingslijn tussen de stappen */
  .step:not(:last-child)::before {
    content: ''; position: absolute; left: 1.75rem; top: 3.75rem; bottom: 0.25rem; width: 2px;
    background: var(--c-brand-line); translate: -50% 0;
  }
  .n {
    display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%;
    background: var(--c-brand); color: var(--c-on-dark);
    font-family: var(--font-display); font-weight: 780; font-size: 1.6rem; letter-spacing: -0.03em;
  }
  .step:last-child .n { background: var(--c-accent); color: var(--c-on-accent); }
  .body { padding-top: 0.35rem; max-width: 30rem; }
  .when { font-size: var(--fs-small); font-weight: 700; color: var(--c-brand); }
  .step h3 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); letter-spacing: -0.025em; margin-top: 0.15rem; }
  .text { margin-top: var(--space-2); color: var(--c-ink-soft); }
  .after { margin-top: clamp(3rem, 2rem + 3vw, 4.5rem); }

  @media (min-width: 60rem) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
    .step { grid-template-columns: 1fr; gap: var(--space-5); padding-bottom: 0; }
    .step:not(:last-child)::before {
      left: 4.5rem; right: calc(var(--space-6) * -1 + 1rem); top: 1.75rem; bottom: auto; width: auto; height: 2px; translate: 0 -50%;
    }
    .body { padding-top: 0; }
  }
</style>
