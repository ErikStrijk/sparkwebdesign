---
/** Mobiel: CTA-balk onderin, verschijnt na de hero en verdwijnt bij het formulier. */
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="sticky" data-sticky aria-hidden="true">
  <a class="btn btn--primary btn--block" href="#contact" tabindex="-1">
    {site.cta}
    <span class="btn__chip"><Icon name="arrow" size={20} /></span>
  </a>
</div>

<style>
  .sticky {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    padding: var(--space-3) var(--space-3) calc(var(--space-3) + env(safe-area-inset-bottom));
    transform: translateY(120%); transition: transform var(--dur) var(--ease-out);
    pointer-events: none;
  }
  .sticky a { pointer-events: auto; box-shadow: 0 14px 34px -10px rgb(5 12 32 / 0.45), 0 14px 34px -14px rgb(56 189 248 / 0.75); }
  .sticky.show { transform: none; }
  @media (min-width: 52rem) { .sticky { display: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky]')!;
  const hero = document.getElementById('top');
  const contact = document.getElementById('contact');
  const footer = document.querySelector('footer');
  const state = { pastHero: false, nearEnd: false };
  const apply = () => {
    const show = state.pastHero && !state.nearEnd;
    bar.classList.toggle('show', show);
    // Alleen bereikbaar met toetsenbord/screenreader als hij zichtbaar is.
    bar.setAttribute('aria-hidden', String(!show));
    bar.querySelector('a')!.tabIndex = show ? 0 : -1;
  };
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => { state.pastHero = !e.isIntersecting; apply(); }).observe(hero);
    const end = new IntersectionObserver((entries) => {
      state.nearEnd = entries.some((e) => e.isIntersecting);
      apply();
    });
    if (contact) end.observe(contact);
    if (footer) end.observe(footer);
  }
</script>
