---
/** Eén consistente iconenset: 24px raster, 2px lijn, ronde uiteinden. */
interface Props { name: 'check' | 'arrow' | 'whatsapp' | 'plus' | 'menu' | 'close' | 'mail' | 'phone' | 'image' | 'user'; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'check' && <path d="M5 12.5l4.2 4.2L19 7" />}
  {name === 'arrow' && <><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === 'close' && <><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></>}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'image' && <><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.75" /><path d="M21 16l-5-5L5 20" /></>}
  {name === 'user' && <><circle cx="12" cy="8.5" r="3.75" /><path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" /></>}
  {name === 'whatsapp' && <><path d="M3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 8 19.3z" /><path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .6.6 1.1 1.5 2 2.6 2.6.2.1.4.1.6 0l.6-.5c.2-.1.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-.6.3-1.6.4-3-.2a9 9 0 0 1-4.2-4.2c-.6-1.4-.5-2.4-.2-3z" /></>}
</svg>
