---
import Cta from './Cta.astro';
import Icon from './Icon.astro';
import T from './T.astro';
import { site, included, hosting, extras } from '../data/site';
---
<section class="section pricing" id="prijs" aria-labelledby="prijs-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="prijs-title">Dit krijg je voor €{site.price}</h2>
      <p>Eén prijs, alles wat je nodig hebt. Wat extra kost, staat er gewoon bij. Geen kleine lettertjes.</p>
    </div>

    <div class="layout">
      <article class="card" data-reveal aria-labelledby="pakket-title">
        <header class="card-head">
          <h3 id="pakket-title">Jouw website</h3>
          <p class="price">
            <span class="amount num">€{site.price}</span>
            <span class="per">eenmalig<br />€{site.upfront} vooraf</span>
          </p>
        </header>
        <ul class="included">
          {included.map((item) => (
            <li><Icon name="check" size={20} class="ok" /><span><T text={item} /></span></li>
          ))}
        </ul>
        <div class="card-cta"><Cta whatsapp={false} /></div>
      </article>

      <div class="side">
        <div class="box" data-reveal style="--reveal-i:1">
          <h3>{hosting.title}</h3>
          <p><T text={hosting.text} /></p>
        </div>
        <div class="box" data-reveal style="--reveal-i:2">
          <h3>Kost extra</h3>
          <p class="hint">Alleen als je het wilt. Je weet de prijs altijd vooraf.</p>
          <dl class="extras">
            {extras.map((x) => (
              <div><dt><T text={x.label} /></dt><dd class="num"><T text={x.price} /></dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    background:
      radial-gradient(60% 55% at 88% 12%, rgb(56 189 248 / 0.16), transparent 70%),
      radial-gradient(45% 50% at 10% 85%, rgb(99 102 241 / 0.1), transparent 70%),
      var(--grad-soft);
  }
  .layout { display: grid; gap: var(--space-5); align-items: start; }

  .card {
    background: var(--grad-card); border-radius: var(--radius-lg);
    box-shadow: var(--shadow); border: 1px solid var(--c-line);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }
  .card-head {
    display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4);
    padding-bottom: var(--space-5); border-bottom: 1px solid var(--c-line);
  }
  .card-head h3 { font-size: var(--fs-h3); letter-spacing: -0.02em; }
  .price { display: flex; align-items: end; gap: var(--space-3); }
  .amount {
    font-family: var(--font-display); font-weight: 780; font-size: clamp(3.25rem, 2.5rem + 3vw, 4.5rem);
    line-height: 0.9; letter-spacing: -0.045em; color: var(--c-brand);
    background: linear-gradient(135deg, var(--c-brand-deep) 0%, var(--c-brand) 60%, #0284c7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .per { font-size: var(--fs-small); font-weight: 600; color: var(--c-muted); line-height: 1.3; padding-bottom: 0.3rem; }

  .included { list-style: none; padding: 0; margin-block: var(--space-5) var(--space-6); display: grid; gap: var(--space-3) var(--space-6); }
  .included li { display: flex; gap: 0.7rem; align-items: start; line-height: 1.45; }
  .included :global(.ok) { color: var(--c-brand); flex: none; margin-top: 0.1rem; }
  .card-cta { padding-top: var(--space-5); border-top: 1px solid var(--c-line); }

  .side { display: grid; gap: var(--space-5); }
  .box {
    background: var(--grad-card); border-radius: var(--radius-lg); border: 1px solid var(--c-line);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .box h3 { font-size: 1.25rem; letter-spacing: -0.015em; }
  .box p { margin-top: var(--space-2); color: var(--c-ink-soft); font-size: var(--fs-small); }
  .box .hint { color: var(--c-muted); }
  .extras { margin-top: var(--space-4); }
  .extras div { display: flex; justify-content: space-between; gap: var(--space-4); padding: 0.7rem 0; border-top: 1px solid var(--c-line); font-size: var(--fs-small); }
  .extras dd { font-weight: 700; white-space: nowrap; }

  @media (min-width: 40rem) {
    .included { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 60rem) {
    .layout { grid-template-columns: 1.7fr 1fr; }
  }
</style>
