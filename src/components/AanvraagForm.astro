---
/**
 * Aanvraagformulier (Web3Forms). Twee varianten:
 * - compact: naam, e-mail, soort bedrijf (in de hero)
 * - full: + "heb je al een website?" (onderaan de pagina)
 * Validatie en versturen: src/scripts/form.ts
 */
import Icon from './Icon.astro';
import T from './T.astro';
import { site } from '../data/site';

interface Props { id: string; compact?: boolean; title?: string; intro?: string }
const { id, compact = false, title, intro } = Astro.props;
const f = (name: string) => `${id}-${name}`;
---
<form
  class:list={['form', { compact }]}
  action="https://api.web3forms.com/submit"
  method="POST"
  data-form
  novalidate
  aria-labelledby={title ? f('title') : undefined}
>
  {title && <h2 class="title" id={f('title')}>{title}</h2>}
  {intro && <p class="intro"><T text={intro} /></p>}

  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value={`Nieuwe aanvraag gratis ontwerp (${compact ? 'hero' : 'contact'})`} />
  <input type="hidden" name="from_name" value="Sparkdesign website" />
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field">
    <label for={f('naam')}>Je naam</label>
    <input id={f('naam')} name="naam" type="text" autocomplete="name" required data-check="name" aria-describedby={f('e-naam')} />
    <p class="error" id={f('e-naam')} hidden>Vul je naam in, dan weet ik wie ik spreek.</p>
  </div>
  <div class="field">
    <label for={f('email')}>Je e-mailadres</label>
    <input id={f('email')} name="email" type="email" autocomplete="email" inputmode="email" required data-check="email" aria-describedby={f('e-email')} />
    <p class="error" id={f('e-email')} hidden>Vul een geldig e-mailadres in, bijv. naam@bedrijf.nl.</p>
  </div>
  <div class="field">
    <label for={f('bedrijf')}>Wat voor bedrijf heb je?</label>
    <input id={f('bedrijf')} name="bedrijf" type="text" placeholder="Bijv. kapsalon of hovenier" required data-check="text" aria-describedby={f('e-bedrijf')} />
    <p class="error" id={f('e-bedrijf')} hidden>Vertel in een paar woorden wat je doet.</p>
  </div>
  {!compact && (
    <fieldset class="field" data-check="radio" aria-describedby={f('e-site')}>
      <legend>Heb je al een website?</legend>
      <div class="choices">
        <label class="choice"><input type="radio" name="bestaande_site" value="ja" /><span>Ja</span></label>
        <label class="choice"><input type="radio" name="bestaande_site" value="nee" /><span>Nee</span></label>
      </div>
      <p class="error" id={f('e-site')} hidden>Kies ja of nee.</p>
    </fieldset>
  )}

  <button class="btn btn--primary btn--block submit" type="submit" data-label={site.cta}>
    <span class="label">{site.cta}</span>
    <span class="btn__chip"><Icon name="arrow" size={20} class="arrow" /><span class="spinner" aria-hidden="true"></span></span>
  </button>
  <p class="reassure"><Icon name="check" size={16} />{site.reassurance}</p>
  <p class="privacy">Ik gebruik je gegevens alleen om contact op te nemen. <a href="/privacy">Privacyverklaring</a></p>

  <div class="status" role="status" aria-live="polite" data-status></div>
</form>

<style>
  .form {
    background: var(--grad-card); color: var(--c-ink);
    border: 1px solid var(--c-line);
    border-radius: 1.5rem; box-shadow: var(--shadow-lg);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: grid; gap: var(--space-4);
    text-align: left;
  }
  .compact { gap: var(--space-3); }
  .form :focus-visible { outline-color: var(--c-accent); }

  .title { font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem); letter-spacing: -0.02em; line-height: 1.15; color: var(--c-ink); }
  .intro { margin-top: calc(var(--space-2) * -1); margin-bottom: var(--space-1); font-size: var(--fs-small); color: var(--c-ink-soft); }

  .field { display: grid; gap: 0.375rem; border: 0; padding: 0; min-width: 0; }
  label, legend { font-weight: 600; font-size: var(--fs-small); padding: 0; }
  input[type='text'], input[type='email'] {
    width: 100%; min-height: 3.125rem; padding: 0 1.125rem;
    border: 1.5px solid #c7d7f0; border-radius: 0.875rem; background: #fff;
    font-size: 1rem; caret-color: var(--c-brand);
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  input::placeholder { color: #5c6f94; }
  input[type='text']:hover, input[type='email']:hover { border-color: #7ba2e0; }
  input[type='text']:focus, input[type='email']:focus { outline: none; border-color: var(--c-brand); box-shadow: 0 0 0 4px rgb(29 78 216 / 0.16); }
  .field.invalid input { border-color: var(--c-error); }
  .error { color: var(--c-error); font-size: var(--fs-small); font-weight: 500; }

  .choices { display: flex; gap: var(--space-3); margin-top: 0.25rem; }
  .choice { flex: 1; position: relative; }
  .choice input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .choice span {
    display: flex; align-items: center; justify-content: center; min-height: 3.125rem;
    border: 1.5px solid #c7d7f0; border-radius: var(--radius-pill); font-weight: 600; font-size: 1rem;
    transition: border-color var(--dur-fast), background var(--dur-fast), color var(--dur-fast);
  }
  .choice:hover span { border-color: #7ba2e0; }
  .choice input:checked + span { border-color: var(--c-brand); background: var(--c-brand-tint); color: var(--c-brand); }
  .choice input:focus-visible + span { outline: 3px solid var(--c-accent); outline-offset: 2px; }
  .field.invalid .choice span { border-color: var(--c-error); }

  .submit { margin-top: var(--space-2); white-space: normal; text-align: left; }
  .submit[disabled] { cursor: progress; opacity: 0.9; }
  .spinner { display: none; width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 2.5px solid currentColor; border-right-color: transparent; animation: spin 700ms linear infinite; }
  .submit.loading .spinner { display: block; }
  .submit.loading :global(.arrow) { display: none; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .reassure { text-align: center; text-wrap: balance; font-size: var(--fs-small); font-weight: 500; color: var(--c-muted); }
  .reassure :global(svg) { display: inline; vertical-align: -3px; margin-right: 0.35rem; color: var(--c-success); }
  .privacy { font-size: var(--fs-xs); color: var(--c-muted); text-align: center; margin-top: calc(var(--space-2) * -1); }
  .privacy a { color: var(--c-ink-soft); }

  .status:empty { display: none; }
  .status { border-radius: 1rem; padding: var(--space-4) var(--space-5); font-weight: 500; }
  :global(.status.ok) { background: #e7f6ee; color: #08583a; }
  :global(.status.err) { background: #fdecea; color: #8a1c12; }
  .status :global(a) { color: inherit; font-weight: 700; }
  .status :global(strong) { display: block; font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -0.015em; }
</style>

<script>
  import '../scripts/form';
</script>
